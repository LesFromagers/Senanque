# FRED API — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# College Football Data API — https://collegefootballdata.com/key
CFBD_API_KEY=

# Supabase (The Heisman Park Ledger) — Project Settings > API in the Supabase
# dashboard. NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to ship to the browser —
# Row Level Security (supabase/heisman-ledger/schema.sql) does the real
# access control. Never put the service-role key here or in any committed
# file; it only ever belongs in your own shell environment for a one-off
# script run.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ASFC Scouting Radar (see ASFC_SCOUTING_RADAR.md)
# API-Football (direct api-sports.io account) — used ONLY by scripts/etl/,
# never by the website. https://dashboard.api-football.com/
API_FOOTBALL_KEY=
# The website reads Supabase with the public URL + anon key only.
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key: ONLY in your own local .env.local (or a GitHub Actions
# secret if a scheduled job is added later). NEVER add it to Vercel and
# never expose it to the browser. Used by scripts/etl/ to write.
SUPABASE_SERVICE_ROLE_KEY=
