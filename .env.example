# FRED API — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# College Football Data API — https://collegefootballdata.com/key
CFBD_API_KEY=

# Supabase (The Heisman Park Ledger) — Project Settings > API in the Supabase
# dashboard. NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to ship to the browser —
# Row Level Security (supabase/heisman-ledger/schema.sql) does the real
# access control. Never put the service-role key here or in any committed
# file; it only ever belongs in your own shell environment for a one-off
# script run.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
